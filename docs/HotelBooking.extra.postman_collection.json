      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin login returns 200', function () { pm.response.to.have.status(200); });",
              "const response = pm.response.json();",
              "pm.test('Admin token is returned', function () { pm.expect(response.token).to.be.a('string').and.not.empty; });",
              "pm.collectionVariables.set('extraAdminToken', response.token);"
