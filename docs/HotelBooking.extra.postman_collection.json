    {
      "name": "3.1 Pay Booking (credit_card)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Credit card payment returns 200', function () { pm.response.to.have.status(200); });",
              "const payment = pm.response.json().data;",
              "pm.test('Credit card payment records points', function () {",
              "  pm.expect(payment.bookingId).to.equal(pm.collectionVariables.get('booking1Id'));",
              "  pm.expect(payment.status).to.equal('paid');",
              "  pm.expect(payment.payment.method).to.equal('credit_card');",
              "  pm.expect(payment.payment.transactionId).to.be.a('string').and.not.empty;",
              "  pm.expect(Number.isNaN(Date.parse(payment.payment.paidAt))).to.be.false;",
              "  pm.expect(payment.pointsEarned).to.equal(Math.floor(payment.totalPrice / 100));",
              "  pm.expect(payment.userAccumulatedPoints).to.equal(Number(pm.collectionVariables.get('startingPoints')) + payment.pointsEarned);",
              "});",
              "pm.collectionVariables.set('points1', payment.pointsEarned);"
            ]
          }
        }
      ],
