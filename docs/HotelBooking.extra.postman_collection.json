    {
      "name": "1.2 Admin Create Promotion",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('promoId');",
              "pm.collectionVariables.set('promoCode', 'EXTRA' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Promotion creation returns 201', function () { pm.response.to.have.status(201); });",
              "const promotion = pm.response.json().data;",
              "pm.test('Promotion starts at 10 percent', function () {",
              "  pm.expect(promotion.code).to.equal(pm.collectionVariables.get('promoCode'));",
              "  pm.expect(promotion.discountValue).to.equal(10);",
              "});",
              "pm.collectionVariables.set('promoId', promotion._id);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{extraAdminToken}}",
              "type": "string"
