    {
      "name": "4.2 Admin Delete Test Promotion",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Test promotion deletion returns 200', function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) {",
