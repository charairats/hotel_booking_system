    {
      "name": "2.3 Create Booking With Promo Code",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('booking1Id');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Promotional booking returns 201', function () { pm.response.to.have.status(201); });",
              "const booking = pm.response.json().data;",
              "pm.test('Booking applies the 20 percent promotion', function () {",
              "  pm.expect(booking.promoCode).to.equal(pm.collectionVariables.get('promoCode'));",
              "  pm.expect(booking.discount).to.equal(Math.round(booking.subTotal * 0.2 * 100) / 100);",
              "  pm.expect(booking.totalPrice).to.equal(Math.round((booking.subTotal - booking.discount) * 100) / 100);",
              "  pm.expect(booking.status).to.equal('pending');",
              "});",
              "pm.collectionVariables.set('booking1Id', booking._id);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{extraUserToken}}",
